<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Scout for Construction Equipment Sales | Territory Sales Software
  </title>

  <meta
    name="description"
    content="Scout helps construction equipment salespeople manage customers, fleets, equipment opportunities, demos, quotes, trade-ins, follow-ups, commissions, and daily territory activity."
  />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --scout-green: #1f4d3f;
      --pine-green: #2f6b53;
      --orange: #d65a1f;
      --orange-dark: #bd4814;

      --warm-white: #fcfbf8;
      --sand: #f7f5f0;
      --white: #ffffff;
      --stone: #e2dfda;
      --soft-border: #ece9e3;

      --charcoal: #1f1f21;
      --graphite: #5c6168;
      --muted: #777b7f;

      --radius-sm: 10px;
      --radius-md: 18px;
      --radius-lg: 28px;

      --shadow-soft:
        0 18px 50px rgba(31, 31, 33, 0.06),
        0 2px 10px rgba(31, 31, 33, 0.04);

      --container: 1180px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      overflow-x: hidden;
      background:
        radial-gradient(
          circle at 88% 4%,
          rgba(214, 90, 31, 0.055),
          transparent 26%
        ),
        var(--warm-white);
      color: var(--charcoal);
      font-family: "Inter", Arial, sans-serif;
      line-height: 1.6;
    }

    img,
    svg {
      display: block;
      max-width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    .container {
      width: min(calc(100% - 40px), var(--container));
      margin: 0 auto;
    }

    .section {
      padding: 105px 0;
    }

    .section-soft {
      background: var(--sand);
    }

    .eyebrow {
      margin: 0 0 15px;
      color: var(--orange);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .section-heading {
      max-width: 790px;
      margin: 0 auto;
      text-align: center;
    }

    .section-heading h2 {
      margin: 0;
      font-size: clamp(2.15rem, 4.3vw, 3.75rem);
      line-height: 1.06;
      letter-spacing: -0.03em;
    }

    .section-heading p {
      max-width: 690px;
      margin: 22px auto 0;
      color: var(--graphite);
      font-size: 1.06rem;
      line-height: 1.8;
    }

    .btn {
      display: inline-flex;
      min-height: 51px;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 0 23px;
      border: 1px solid transparent;
      border-radius: 9px;
      cursor: pointer;
      font-weight: 700;
      transition:
        transform 160ms ease,
        color 160ms ease,
        background-color 160ms ease,
        border-color 160ms ease;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-primary {
      background: var(--orange);
      color: var(--white);
    }

    .btn-primary:hover {
      background: var(--orange-dark);
    }

    .btn-secondary {
      border-color: var(--orange);
      background: transparent;
      color: var(--orange);
    }

    .btn-secondary:hover {
      background: rgba(214, 90, 31, 0.06);
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--scout-green);
      font-weight: 700;
      transition: color 160ms ease;
    }

    .text-link:hover {
      color: var(--orange);
    }

    /* Header */

    .site-header {
      position: relative;
      z-index: 20;
      padding: 22px 0;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      color: var(--scout-green);
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.05em;
    }

    .logo-mark {
      display: inline-flex;
      width: 34px;
      height: 34px;
      align-items: center;
      justify-content: center;
      color: var(--orange);
    }

    .main-nav {
      display: flex;
      align-items: center;
      gap: 31px;
      color: #373a3d;
      font-size: 0.93rem;
      font-weight: 600;
    }

    .main-nav a {
      transition: color 150ms ease;
    }

    .main-nav a:hover,
    .main-nav a.active {
      color: var(--orange);
    }

    .mobile-menu-button {
      display: none;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--stone);
      border-radius: 9px;
      background: var(--white);
      color: var(--charcoal);
      cursor: pointer;
    }

    .mobile-nav {
      display: none;
      padding: 12px 0 20px;
    }

    .mobile-nav.open {
      display: grid;
    }

    .mobile-nav a {
      padding: 13px 0;
      border-bottom: 1px solid var(--stone);
      font-weight: 600;
    }

    /* Hero */

    .hero {
      padding: 68px 0 112px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(410px, 0.92fr);
      gap: 72px;
      align-items: center;
    }

    .hero-copy h1 {
      max-width: 770px;
      margin: 0;
      font-size: clamp(3.1rem, 5.6vw, 5.8rem);
      line-height: 0.98;
      letter-spacing: -0.062em;
    }

    .hero-copy h1 span {
      display: block;
      margin-top: 20px;
      color: var(--orange);
      font-size: 0.63em;
      line-height: 1.05;
      letter-spacing: -0.045em;
    }

    .hero-copy > p {
      max-width: 680px;
      margin: 29px 0 0;
      color: var(--graphite);
      font-size: 1.12rem;
      line-height: 1.82;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 25px;
      margin-top: 36px;
    }

    .hero-note {
      max-width: 575px;
      margin-top: 31px;
      padding-left: 17px;
      border-left: 3px solid var(--orange);
      color: var(--graphite);
      font-size: 0.9rem;
      line-height: 1.65;
    }

    /* Hero visual */

    .territory-board {
      position: relative;
      min-height: 555px;
      overflow: hidden;
      padding: 36px;
      border: 1px solid rgba(31, 77, 63, 0.08);
      border-radius: 32px;
      background:
        repeating-linear-gradient(
          0deg,
          transparent 0,
          transparent 29px,
          rgba(31, 77, 63, 0.035) 30px
        ),
        #f8f5ec;
    }

    .territory-board::before {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(
          circle at 55% 46%,
          rgba(255, 255, 255, 0.95),
          transparent 56%
        );
      content: "";
    }

    .map-lines {
      position: absolute;
      inset: 17px;
      opacity: 0.27;
    }

    .map-road {
      stroke: var(--scout-green);
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-dasharray: 8 10;
    }

    .territory-label {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid var(--stone);
      border-radius: 30px;
      background: rgba(255, 255, 255, 0.9);
      color: var(--scout-green);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .opportunity-card {
      position: absolute;
      z-index: 3;
      width: 260px;
      padding: 19px;
      border: 1px solid var(--stone);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: var(--shadow-soft);
    }

    .opportunity-card:nth-of-type(2) {
      top: 103px;
      left: 35px;
      transform: rotate(-1deg);
    }

    .opportunity-card:nth-of-type(3) {
      top: 230px;
      right: 26px;
      transform: rotate(1.4deg);
    }

    .opportunity-card:nth-of-type(4) {
      bottom: 42px;
      left: 65px;
      transform: rotate(-0.6deg);
    }

    .card-topline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .machine-icon {
      display: inline-flex;
      width: 42px;
      height: 42px;
      align-items: center;
      justify-content: center;
      border: 1.5px solid var(--scout-green);
      border-radius: 50%;
      color: var(--scout-green);
    }

    .status {
      display: inline-flex;
      min-height: 27px;
      align-items: center;
      padding: 0 9px;
      border-radius: 20px;
      background: rgba(214, 90, 31, 0.08);
      color: var(--orange);
      font-size: 0.67rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .opportunity-card h3 {
      margin: 16px 0 0;
      font-size: 0.95rem;
      letter-spacing: -0.02em;
    }

    .opportunity-card p {
      margin: 7px 0 0;
      color: var(--muted);
      font-size: 0.76rem;
      line-height: 1.55;
    }

    .opportunity-meta {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-top: 15px;
      padding-top: 13px;
      border-top: 1px solid var(--soft-border);
      color: var(--graphite);
      font-size: 0.69rem;
      font-weight: 600;
    }

    .map-pin {
      position: absolute;
      z-index: 2;
      width: 22px;
      height: 22px;
      border: 5px solid rgba(255, 255, 255, 0.94);
      border-radius: 50% 50% 50% 0;
      background: var(--orange);
      box-shadow: 0 4px 10px rgba(31, 31, 33, 0.14);
      transform: rotate(-45deg);
    }

    .pin-one {
      top: 185px;
      left: 330px;
    }

    .pin-two {
      right: 160px;
      bottom: 130px;
    }

    .hand-note {
      position: absolute;
      right: 21px;
      bottom: 18px;
      z-index: 4;
      max-width: 167px;
      padding: 13px 15px;
      background: #fff2a9;
      box-shadow: 0 7px 18px rgba(31, 31, 33, 0.12);
      color: #4e4a39;
      font-family: "Caveat", cursive;
      font-size: 1.07rem;
      line-height: 1.08;
      transform: rotate(3deg);
    }

    /* Statement section */

    .statement-section {
      padding: 10px 0 105px;
    }

    .statement-card {
      max-width: 930px;
      margin: 0 auto;
      padding: 53px 60px;
      border: 1px solid var(--stone);
      border-radius: var(--radius-lg);
      background: var(--white);
      box-shadow: var(--shadow-soft);
      text-align: center;
    }

    .statement-card p {
      margin: 0;
      font-family: "Caveat", cursive;
      font-size: clamp(2.15rem, 4.3vw, 3.7rem);
      font-weight: 600;
      line-height: 1.1;
    }

    .statement-card span {
      color: var(--orange);
    }

    /* Familiar problems */

    .pain-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-top: 58px;
    }

    .pain-card {
      position: relative;
      min-height: 245px;
      overflow: hidden;
      padding: 31px;
      border: 1px solid var(--stone);
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.8);
    }

    .pain-card::after {
      position: absolute;
      right: -30px;
      bottom: -55px;
      width: 140px;
      height: 140px;
      border: 1px solid rgba(31, 77, 63, 0.08);
      border-radius: 50%;
      content: "";
    }

    .pain-number {
      display: inline-flex;
      width: 42px;
      height: 42px;
      align-items: center;
      justify-content: center;
      border: 1.5px solid var(--orange);
      border-radius: 50%;
      color: var(--orange);
      font-family: "Caveat", cursive;
      font-size: 1.3rem;
      font-weight: 700;
    }

    .pain-card h3 {
      max-width: 490px;
      margin: 22px 0 0;
      font-size: 1.24rem;
      line-height: 1.42;
      letter-spacing: -0.025em;
    }

    .pain-card p {
      max-width: 500px;
      margin: 13px 0 0;
      color: var(--graphite);
      font-size: 0.91rem;
      line-height: 1.7;
    }

    /* Features */

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 19px;
      margin-top: 58px;
    }

    .feature-card {
      min-height: 240px;
      padding: 29px;
      border: 1px solid var(--stone);
      border-radius: var(--radius-md);
      background: var(--white);
      box-shadow: 0 8px 25px rgba(31, 31, 33, 0.025);
      transition:
        transform 170ms ease,
        box-shadow 170ms ease;
    }

    .feature-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-soft);
    }

    .feature-icon {
      display: inline-flex;
      width: 48px;
      height: 48px;
      align-items: center;
      justify-content: center;
      border: 1.5px solid var(--scout-green);
      border-radius: 50%;
      color: var(--scout-green);
    }

    .feature-card:nth-child(3n + 2) .feature-icon {
      border-color: var(--orange);
      color: var(--orange);
    }

    .feature-card h3 {
      margin: 22px 0 0;
      font-size: 1.04rem;
      letter-spacing: -0.02em;
    }

    .feature-card p {
      margin: 11px 0 0;
      color: var(--graphite);
      font-size: 0.87rem;
      line-height: 1.7;
    }

    /* Opportunity examples */

    .example-layout {
      display: grid;
      grid-template-columns: 0.78fr 1.22fr;
      gap: 75px;
      align-items: start;
      margin-top: 64px;
    }

    .example-intro {
      position: sticky;
      top: 40px;
    }

    .example-intro h2 {
      margin: 0;
      font-size: clamp(2.15rem, 4vw, 3.55rem);
      line-height: 1.07;
      letter-spacing: -0.05em;
    }

    .example-intro p {
      margin: 23px 0 0;
      color: var(--graphite);
      font-size: 1.02rem;
      line-height: 1.82;
    }

    .example-list {
      display: grid;
      gap: 17px;
    }

    .example-card {
      padding: 28px 29px;
      border: 1px solid var(--stone);
      border-radius: 17px;
      background: var(--white);
      box-shadow: 0 7px 24px rgba(31, 31, 33, 0.025);
    }

    .example-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
    }

    .example-card h3 {
      margin: 0;
      font-size: 1.03rem;
    }

    .example-type {
      flex: 0 0 auto;
      padding: 5px 9px;
      border-radius: 20px;
      background: rgba(31, 77, 63, 0.07);
      color: var(--scout-green);
      font-size: 0.64rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .example-card p {
      margin: 12px 0 0;
      color: var(--graphite);
      font-size: 0.89rem;
      line-height: 1.7;
    }

    .example-footer {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 19px;
    }

    .example-detail {
      padding: 7px 10px;
      border: 1px solid var(--soft-border);
      border-radius: 8px;
      color: var(--muted);
      font-size: 0.71rem;
      font-weight: 600;
    }

    /* Day timeline */

    .day-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 14px;
      margin-top: 59px;
    }

    .day-card {
      position: relative;
      min-height: 225px;
      padding: 28px 21px;
      border: 1px solid var(--stone);
      border-radius: var(--radius-md);
      background: var(--white);
      text-align: center;
    }

    .day-card:not(:last-child)::after {
      position: absolute;
      top: 50%;
      right: -21px;
      z-index: 3;
      color: var(--orange);
      content: "→";
      font-size: 1.3rem;
      font-weight: 800;
      transform: translateY(-50%);
    }

    .day-time {
      display: inline-flex;
      min-height: 30px;
      align-items: center;
      padding: 0 11px;
      border-radius: 30px;
      background: rgba(214, 90, 31, 0.08);
      color: var(--orange);
      font-size: 0.68rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .day-icon {
      display: flex;
      width: 47px;
      height: 47px;
      align-items: center;
      justify-content: center;
      margin: 22px auto 0;
      border: 1.5px solid var(--scout-green);
      border-radius: 50%;
      color: var(--scout-green);
    }

    .day-card h3 {
      margin: 19px 0 0;
      font-size: 0.94rem;
      line-height: 1.4;
    }

    .day-card p {
      margin: 9px 0 0;
      color: var(--muted);
      font-size: 0.76rem;
      line-height: 1.55;
    }

    /* Results */

    .results-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-top: 56px;
    }

    .result-card {
      padding: 31px 25px;
      border: 1px solid var(--stone);
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.82);
      text-align: center;
    }

    .result-card strong {
      display: block;
      color: var(--orange);
      font-family: "Caveat", cursive;
      font-size: 2.3rem;
      line-height: 1;
    }

    .result-card h3 {
      margin: 15px 0 0;
      font-size: 0.95rem;
    }

    .result-card p {
      margin: 9px 0 0;
      color: var(--muted);
      font-size: 0.78rem;
      line-height: 1.55;
    }

    /* Founder story */

    .story-card {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 72px;
      align-items: center;
      padding: 68px 75px;
      border-radius: var(--radius-lg);
      background:
        radial-gradient(
          circle at 8% 10%,
          rgba(214, 90, 31, 0.06),
          transparent 31%
        ),
        var(--sand);
    }

    .story-quote blockquote {
      margin: 0;
      font-family: "Caveat", cursive;
      font-size: clamp(2.2rem, 4vw, 3.7rem);
      font-weight: 600;
      line-height: 1.06;
    }

    .hand-underline {
      position: relative;
      display: inline-block;
    }

    .hand-underline::after {
      position: absolute;
      right: -3px;
      bottom: -7px;
      left: -3px;
      height: 4px;
      border-radius: 50%;
      background: var(--orange);
      content: "";
      transform: rotate(-1deg);
    }

    .founder {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 31px;
    }

    .founder-image {
      display: flex;
      width: 53px;
      height: 53px;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      border-radius: 50%;
      background: linear-gradient(145deg, #dededb, #b9bdb9);
      color: var(--scout-green);
      font-weight: 800;
    }

    .founder strong {
      display: block;
      font-size: 0.94rem;
    }

    .founder span {
      color: var(--graphite);
      font-size: 0.8rem;
    }

    .story-copy p {
      margin: 0 0 20px;
      color: #42474a;
      font-size: 1.04rem;
      line-height: 1.86;
    }

    /* CRM section */

    .crm-card {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
      margin-top: 57px;
      padding: 52px;
      border: 1px solid var(--stone);
      border-radius: var(--radius-lg);
      background: var(--white);
      box-shadow: var(--shadow-soft);
    }

    .crm-copy h3 {
      margin: 0;
      font-size: clamp(1.8rem, 3vw, 2.75rem);
      line-height: 1.1;
      letter-spacing: -0.04em;
    }

    .crm-copy p {
      margin: 20px 0 0;
      color: var(--graphite);
      line-height: 1.8;
    }

    .crm-flow {
      display: grid;
      gap: 14px;
    }

    .crm-flow-item {
      display: grid;
      grid-template-columns: 42px 1fr;
      gap: 14px;
      align-items: center;
      min-height: 74px;
      padding: 13px 16px;
      border: 1px solid var(--soft-border);
      border-radius: 13px;
      background: #fdfcf9;
    }

    .crm-flow-item.scout {
      border: 2px solid var(--orange);
      background: #fffaf6;
      transform: rotate(-0.5deg);
    }

    .crm-flow-icon {
      display: flex;
      width: 39px;
      height: 39px;
      align-items: center;
      justify-content: center;
      border: 1.5px solid var(--scout-green);
      border-radius: 50%;
      color: var(--scout-green);
    }

    .crm-flow-item.scout .crm-flow-icon {
      border-color: var(--orange);
      color: var(--orange);
    }

    .crm-flow-item strong {
      display: block;
      font-size: 0.9rem;
    }

    .crm-flow-item span {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 0.72rem;
    }

    /* Quote */

    .quote-section {
      padding: 120px 0;
    }

    .big-quote {
      max-width: 990px;
      margin: 0 auto;
      text-align: center;
    }

    .big-quote blockquote {
